{"name":"Codippy","short_name":"Codippy","description":"Encuentra cualquier código postal de España al instante: por código, ciudad o calle. Pega una dirección y la IA la localiza. Sin conexión, sin cuentas y gratis.","start_url":"/","display":"browser","lang":"es","background_color":"#07061a","theme_color":"#5856d6","icons":[{"src":"/icons/icon-192.png","sizes":"192x192","type":"image/png"},{"src":"/icons/icon-512.png","sizes":"512x512","type":"image/png","purpose":"any"}]}