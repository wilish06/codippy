{
  "sourceLanguage": "es",
  "strings": {
    "Abrir en Codippy": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open in Codippy"
          }
        }
      }
    },
    "Cancelar": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cancel"
          }
        }
      }
    },
    "Codippy": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Codippy"
          }
        }
      }
    },
    "El servidor ha devuelto una respuesta inesperada.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The server returned an unexpected response."
          }
        }
      }
    },
    "Ese código no tiene el formato de %@ (por ejemplo, %@).": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "That code does not match the format used in %1$@ (for example, %2$@)."
          }
        }
      }
    },
    "Leyendo la dirección…": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reading the address…"
          }
        }
      }
    },
    "No ha llegado ningún texto.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No text was received."
          }
        }
      }
    },
    "No se ha encontrado ningún resultado.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No results found."
          }
        }
      }
    },
    "No se ha podido cargar la lista de países.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The list of countries could not be loaded."
          }
        }
      }
    },
    "No se ha podido descargar. Inténtalo de nuevo.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Download failed. Please try again."
          }
        }
      }
    },
    "No se ha podido obtener tu ubicación.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your location could not be determined."
          }
        }
      }
    },
    "Permiso de localización denegado. Actívalo en Ajustes.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Location permission denied. Enable it in Settings."
          }
        }
      }
    },
    "Puedes abrirla en Codippy para revisarla a mano.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You can open it in Codippy to review it by hand."
          }
        }
      }
    },
    "Sigue escribiendo: los códigos postales de %@ son como %@.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Keep typing: postal codes in %1$@ look like %2$@."
          }
        }
      }
    },
    "Sin conexión. Las búsquedas por calle y en países sin datos offline necesitan internet.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You are offline. Street searches and countries without offline data need an internet connection."
          }
        }
      }
    },
    "Toca un resultado para copiar el código.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tap a result to copy its code."
          }
        }
      }
    }
  },
  "version": "1.0"
}
